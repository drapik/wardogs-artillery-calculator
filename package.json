{
  "name": "wardogs-artillery-calculator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "download:model": "node scripts/download-whisper-model.mjs",
    "dev:server": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "cookie-parser": "1.4.7",
    "discord.js": "14.28.1",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "opusscript": "0.0.8",
    "prism-media": "1.3.5",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "prettier": "3.6.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "@huggingface/transformers": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "whisper.cpp": "^1.0.3"
  }
